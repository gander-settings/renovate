{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Base config: recommended defaults, pinned GitHub Actions digests, weekly lock file maintenance, semantic commits, monorepo grouping and a 3-day release age."
  ],
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":maintainLockFilesWeekly",
    ":semanticCommits",
    "group:monorepos"
  ],
  "dependencyDashboard": false,
  "minimumReleaseAge": "3 days",
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "separateMultipleMinor": true,
  "separateMinorPatch": true,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null
  },
  "assignees": ["gander"],
  "rebaseWhen": "auto",
  "labels": ["dependencies"]
}
