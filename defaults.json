{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Base config: recommended defaults, pinned GitHub Actions digests, weekly lock file maintenance, semantic commits, monorepo grouping and a 3/7/30-day release age for patch/minor/major."
  ],
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":maintainLockFilesWeekly",
    ":semanticCommits",
    "group:monorepos"
  ],
  "dependencyDashboard": false,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "internalChecksFilter": "strict",
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "separateMultipleMinor": true,
  "separateMinorPatch": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "3 days"
    },
    {
      "matchUpdateTypes": ["minor"],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "30 days"
    },
    {
      "description": "No release timestamps available: pinning is safer than leaving unpinned",
      "matchUpdateTypes": ["pinDigest"],
      "minimumReleaseAge": null
    },
    {
      "description": "No release timestamps available: registries and datasources that do not expose them",
      "matchDatasources": ["github-runners"],
      "minimumReleaseAge": null
    },
    {
      "description": "No release timestamps on GHCR: allow the zizmor image through",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/zizmorcore/zizmor"],
      "minimumReleaseAge": null
    }
  ],
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null
  },
  "assignees": ["gander"],
  "rebaseWhen": "auto",
  "labels": ["dependencies"]
}
